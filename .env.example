# ============================================================================
# CatatCepat SaaS - Contoh Konfigurasi Environment (.env.example)
# Salin file ini menjadi .env.local untuk pengembangan di komputer lokal.
# PENTING (Audit #11):
# 1. Gunakan kredensial/secret BERBEDA antara lokal (.env.local) dan produksi (Vercel Dashboard).
# 2. Jangan pernah commit .env.local ke Git.
# 3. Jika secret produksi pernah terbuka di log/layar, segera rotasi (buat ulang) di:
#    - Google Cloud Console > Credentials (GOOGLE_CLIENT_SECRET)
#    - Google AI Studio (GEMINI_API_KEY)
#    - Supabase Dashboard > Project Settings > API
# ============================================================================

# URL aplikasi (di lokal: http://localhost:3000, di Vercel produksi: https://catatcepat.web.id)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 untuk sinkronisasi Google Sheets (scope: drive.file)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Kunci enkripsi AES-256-GCM untuk token OAuth (wajib string acak minimal 32 karakter di produksi)
# Contoh generate di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_SECRET=ganti_dengan_64_karakter_hex_acak_minimal_32_karakter_1234567890

# Gemini API Key untuk fitur Catat Suara/Teks AI, Scan Foto Struk, dan Tanya Guri
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_API_KEY_BACKUP=

# Opsional: AI Gateway OpenAI-compatible sebagai cadangan
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Supabase Multi-Tenant Cloud (lihat skema tabel & RLS di supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=

# 5. Web Push Notifications (PWA) & Vercel Cron
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@catatcepat.web.id
CRON_SECRET=your_random_cron_secret_here
