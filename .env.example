# App URL (dipakai untuk redirect Google OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 (scope non-sensitive: drive.file)
# Buat di Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opsional: Enkripsi token & session SaaS (isi string random 32+ karakter)
APP_ENCRYPTION_SECRET=ganti-dengan-secret-minimal-32-karakter

# Opsional: Gemini API Key untuk parsing suara/teks & scan struk AI
# Jika kosong, CatatCepat tetap berjalan memakai parser lokal bahasa Indonesia
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-2.5-flash
# Opsional: API key Gemini cadangan (dari project Google lain)
GEMINI_API_KEY_BACKUP=

# Opsional: AI Gateway OpenAI-compatible (mis. Helipod / OpenRouter) sebagai cadangan
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Opsional (untuk mode produksi multi-tenant PostgreSQL / Supabase)
# Lihat skema lengkap di supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
